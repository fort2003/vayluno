# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Authentification administrateur VAYLUNO (Espace privé sécurisé)
# Personnalisez ces identifiants pour sécuriser l'accès à /Admin-fanahy
ADMIN_USERNAME="admin@vayluno.com"
ADMIN_PASSWORD="Vayluno2026!Secure"
SESSION_SECRET="generer_une_cle_secrete_aleatoire_32_octets"

# Configuration transmission des e-mails du formulaire de contact VAYLUNO
# L'adresse e-mail de réception privée où vous recevrez toutes les demandes des visiteurs
CONTACT_RECEIVER_EMAIL="harmonio2019@gmail.com"

# Clé API du service transactionnel (ex : Resend https://resend.com ou SendGrid)
EMAIL_API_KEY="re_votre_cle_api_secrete"

# Adresse d'expédition vérifiée auprès de votre fournisseur d'e-mails
EMAIL_FROM="VAYLUNO <onboarding@resend.dev>"


